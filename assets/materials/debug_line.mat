// Unlit vertex-coloured lines for the debug draw. Alpha-blended so grids can
// be faint. Unlit output is not exposed by Filament, so the authored colour is
// used as is (dividing by exposure saturated every colour to white).
material {
    name : debug_line,
    shadingModel : unlit,
    requires : [ color ],
    blending : transparent,
    culling : none,
    depthWrite : false
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = getColor();
        material.baseColor = vec4(c.rgb * c.a, c.a);
    }
}
