// Engine tunables. Units: metres, seconds, degrees unless noted.
{
  "window": {
    "title": "Cricket (Milestone 1)",
    "width": 1600,
    "height": 900,
    "resizable": true,
    // Window mode: "fullscreen" | "maximized" | "right"/"left" (half screen) | "center" (width x height, fitted)
    "dockDebug": "maximized",     // dev builds: normal window, movable / minimizable / resizable
    "dockRelease": "fullscreen",  // player builds
    "maxScreenFraction": 0.9,     // "center" only: never larger than this share of the screen
    "vsync": true
  },
  "sim": {
    "tickHz": 120,
    "maxStepsPerFrame": 8,
    // Test probe that circles the pitch to show fixed-step interpolation.
    "probe": { "radius": 12.0, "angularSpeed": 0.5, "height": 1.0 }
  },
  "render": {
    "backend": "opengl",          // "opengl" or "vulkan"
    "assetDir": "assets",
    "shadows": false,
    "shadowMapSize": 2048,
    "shadowCascades": 4,
    "shadowFar": 150.0,
    "debugLineCapacity": 65536
  },
  "lighting": {
    "sunDirection": [-0.45, -0.8, -0.35],   // direction the light travels
    "sunColor": [1.0, 0.96, 0.9],
    "sunIlluminance": 110000.0,             // lux (clear midday sun)
    "skyColor": [0.30, 0.50, 0.90],         // linear RGB, zenith
    "horizonColor": [0.70, 0.80, 0.92],
    "groundColor": [0.18, 0.26, 0.12],      // grass bounce
    "iblIntensity": 30000.0
  },
  "camera": {
    "fovY": 50.0,
    "near": 0.1,
    "far": 2000.0,
    "orbit": {
      "target": [0.0, 0.5, 0.0],
      "home": [22.0, 12.0, 26.0],
      "rotateDegPerPixel": 0.5,     // live-tunable in the Debug panel ("Camera speed")
      "zoomStep": 0.15,             // fraction of the view distance per wheel notch
      "minEyeHeight": 0.3,          // m above the ground; the eye never goes under the field
      "minDistance": 1.5,           // m from the target (zoom never passes through it)
      "maxDistance": 300.0
    }
  },
  "debug": {
    "showOverlay": true,
    "debugDraw": true
  },
  // Picking test driver (T): the ball starts `distance` m in front of the
  // fielder and moves straight past them (no physics) at a random speed
  // (m/s), rolling for groundShare of throws, else at a random height (m),
  // up to sideSpread m to either side; it stops passDistance m behind them.
  "feeder": {
    "distance": 12.0,
    "speedMin": 3.0,
    "speedMax": 6.0,
    "heightMin": 0.4,
    "heightMax": 1.8,
    "groundShare": 0.5,
    "sideSpread": 1.0,
    "passDistance": 5.0
  }
}
