// Fielder locomotion. Metres, seconds; angles in degrees. Sources in
// docs/BIOMECHANICS.md section 4 (walking gait).
{
  "walk": {
    "speed": 1.35,          // m/s at full input (comfortable adult walk)
    "backSpeed": 0.9,       // m/s walking backward (S)
    "sideSpeed": 0.8,       // m/s sidestepping (A/D)
    "acceleration": 5.0,    // m/s^2; full speed within the first step (full-size steps at once)
    "deceleration": 5.0,    // m/s^2; stops within about one step
    "turnRateDeg": 180,     // per second
    "stepK": 0.25,          // step length = stepK * height * (v / refSpeed)^0.42 (0.45 m at 1.8 m: short, smooth steps)
    "refSpeed": 1.35,
    "swingFraction": 0.8,   // swing time / step period; the rest is double support
    "minSwing": 0.3,        // s
    "maxSwing": 0.5,        // s; also used for the settling steps when stopping
    "stepHeight": 0.15,     // ankle apex in swing: shortens the leg ~12 cm, so the swing knee bends ~60 deg (real gait peak)
    "swingPeakAt": 0.3,     // apex early in the swing (heel up first), then the foot goes on low to the landing
    "settleDistance": 0.12, // m; on stop, a foot closer than this to its stance spot stays put
    "bob": 0.025,           // pelvis bob peak-to-peak at full speed, lowest in double support
    "sway": 0.02,           // pelvis sway toward the stance foot
    "leanPerSpeedDeg": 2.0, // forward lean per m/s
    "leanPerAccelDeg": 3.0, // forward lean per m/s^2 (back when braking)
    "turnLeanDeg": 3.0,     // lean into turns per (rad/s * m/s)
    "maxLeanDeg": 10,
    "leanRate": 6.0,        // 1/s, lean smoothing
    // Arms swing opposite the same-side leg; full at walking speed forward,
    // fading out for sidesteps and backing up.
    "armSwingDeg": 35,      // shoulder swing, total range
    "armBackBiasDeg": 5,    // swing centre behind vertical (more extension than flexion)
    "elbowBiasDeg": 25,     // mean elbow bend
    "elbowSwingDeg": 20,    // extra bend at the forward end of the swing
    "armRate": 8.0,         // 1/s, arm smoothing
    // Head stays upright and leads turns (W toward a new heading).
    "headStabilise": 0.8,   // 0..1, share of body lean and sway the head cancels
    "headLeadDeg": 30,      // max head turn ahead of the body
    "headRate": 6.0,        // 1/s, head turn smoothing
    // Foot roll: heel strike (toes up), flat, heel rise over the ball, toe-off.
    "landPitchDeg": -10,    // toes up at heel strike
    "toeOffPitchDeg": 18    // plantarflexion at toe-off (15-20 deg)
  },
  // Pace presets (Ctrl: jog, Shift: run). The gait shape blends
  // walk -> jog -> run by the actual speed. docs/BIOMECHANICS.md section 5.
  // Keys left out use the previous preset ("jog" from "walk", "run" from "jog").
  "jog": {
    "speed": 3.0,            // m/s
    "backSpeed": 1.8,        // m/s backpedal
    "sideSpeed": 1.8,        // m/s side shuffle
    "acceleration": 3.5,
    "deceleration": 5.0,
    "turnRateDeg": 220,
    "stepK": 0.6,            // 1.08 m step at 3 m/s (H = 1.8): ~167 steps/min
    "refSpeed": 3.0,
    "swingFraction": 1.0,    // no double support
    "flightFraction": 0.2,   // stance ~40 % of the stride
    "toeOffPitchDeg": 25,
    "landPitchDeg": -8,      // rearfoot/midfoot strike
    "swingPeakAt": 0.42,     // early apex: heel recovery
    "minSwing": 0.2,
    "maxSwing": 0.5,
    "stepHeight": 0.22,      // heel recovery height
    "widthScale": 0.85,      // feet land a little nearer the midline than standing
    "sideFollow": 0.4,       // pelvis shifts only partly over the stance foot
    "bob": 0.07,             // lowest mid-stance (flipped from walking)
    "sway": 0.012,
    "pelvisTwistDeg": 5,
    "chestCounter": 1.4,
    "pelvisDrop": 0.02,      // stance knee ~35 deg mid-stance
    "leanPerSpeedDeg": 1.7,  // ~5 deg at 3 m/s
    "leanPerAccelDeg": 4.0,
    "maxLeanDeg": 20,
    "armSwingDeg": 55,
    "armBackBiasDeg": 0,
    "elbowBiasDeg": 80,      // elbows near 90 deg
    "elbowSwingDeg": 12,
    "armRate": 10.0
  },
  "run": {
    "speed": 5.0,            // m/s, full run (sprint to ~9 m/s comes later)
    "minSpeed": 2.5,         // m/s, slowest run (mouse wheel down while Shift is held)
    "paceStep": 0.25,        // m/s per mouse-wheel notch
    // No backSpeed / sideSpeed: backing up and sidesteps stay at jog pace and shape.
    "acceleration": 4.0,
    "turnRateDeg": 240,
    "stepK": 0.92,           // 1.66 m step at 5 m/s: ~181 steps/min
    "refSpeed": 5.0,
    "flightFraction": 0.4,   // stance ~30 % of the stride
    "toeOffPitchDeg": 35,
    "landPitchDeg": -3,      // midfoot
    "swingPeakAt": 0.38,
    "stepHeight": 0.36,      // heel higher toward the buttock
    "widthScale": 0.8,       // feet near, not on, the midline; each keeps its own lane
    "landAhead": 0.35,       // foot lands ~1/3 of its contact travel ahead of the hips (shin near vertical; most contact behind)
    "sideFollow": 0.25,      // ~1-2 cm sideways pelvis shift
    "bob": 0.06,             // less oscillation as speed rises
    "sway": 0.008,
    "pelvisTwistDeg": 6,
    "chestCounter": 1.6,
    "pelvisDrop": 0.035,     // stance knee ~40-45 deg mid-stance
    "leanPerSpeedDeg": 1.4,  // ~7 deg at 5 m/s
    "armSwingDeg": 80,       // hands from about chin height to behind the hip
    "armBackBiasDeg": -5,
    "elbowBiasDeg": 88,
    "elbowSwingDeg": 10,
    "armRate": 12.0
  },
  // Single steps while standing (motion::StepSettings): one foot at a time;
  // the body follows from body reposition (fielder_joints.json "bodyReposition").
  "step": {
    "stepLength": 0.4,       // m forward, ahead of the planted foot (short, comfortable step)
    "backStepLength": 0.3,   // m back
    "sideStepLength": 0.3,   // m to the side (the foot on that side leads)
    "stepDuration": 0.6,     // s per step: weight shift, then the swing (about 0.4 s, BIOMECHANICS 4.2)
    "liftAt": 0.0,           // share of the step the foot stays down first (0: lifts at once; no weight shift without gravity)
    "stepHeight": 0.2,       // m ankle apex: the knee bends, the heel rises (about 25 cm, 4.5)
    "swingPeakAt": 0.35      // apex early in the swing (heel up first, toes low at landing)
  },
  // Standing jump (motion::JumpSettings): crouch, push-off, ballistic flight, landing.
  "jump": {
    "crouchDepth": 0.18,     // m pelvis drop at the deepest load
    "loadTime": 0.35,        // s to the deepest load while J is held
    "minLoad": 0.4,          // share of the deepest load a tap gives
    "moveLoad": 0.3,         // walking/running jump: a small dip to this share, then take-off
    "crouchLeanDeg": 20,     // trunk forward at the deepest load
    "pushTime": 0.16,        // s legs extend to take-off
    "movePushTime": 0.08,    // s, moving: one quick push off the stance foot
    "moveHeight": 0.15,      // m, moving: the body rises this much in the bound (flight ~0.35 s)
    "moveKnee": 0.35,        // x leg length, moving bound: the driving foot lifts this high (knee up), coming down to land
    "moveReach": 0.4,        // x leg length, moving: the swing foot drives this far ahead of the body and lands there
    "moveTrail": 0.5,        // x leg length, moving: the take-off foot trails this far behind the body in the air, leg straight
    "pushLift": 0.04,        // m pelvis above standing at take-off
    "height": 0.35,          // m rise after take-off at the deepest load
    "forwardDistance": 0.9,  // m travelled at the deepest load
    "backDistance": 0.45,
    "sideDistance": 0.7,
    "tuck": 0.12,            // m feet draw up mid-flight
    "leanDeg": 11,           // toward the jump direction
    "landDepth": 0.14,       // m pelvis sinks absorbing the landing
    "landTime": 0.12,
    "recoverTime": 0.35,
    // Arms (research notes in jump_controller.h). Flexion forward-up, abduction out.
    "armBackDeg": 50,        // back swing at the deepest load, straight up
    "armBackForwardDeg": 70, // back swing, forward jump
    "armUpDeg": 155,         // take-off, straight up (overhead)
    "armUpForwardDeg": 125,  // forward jump (along the path)
    "armUpBackDeg": 90,      // backward jump
    "armUpSideDeg": 135,     // side jump, lead arm up...
    "sideOutDeg": 60,        // ...and out to the jump side
    "acrossFlexDeg": 70,     // side jump, trail arm forward...
    "acrossDeg": 30,         // ...and across the chest
    "flightFall": 0.5,       // share of the way to the landing pose the arms go in flight
    "landFlexDeg": 70,       // landing: arms forward to shoulder height
    "landSideOutDeg": 70,    // side jump landing: arms out for balance
    "landSideFlexDeg": 20,
    "elbowLoadDeg": 35,      // elbows on the back swing
    "elbowTopDeg": 15,       // nearly straight at take-off
    "elbowLandDeg": 35,      // soft on landing
    // Moving jump: the gait's opposed arms, bigger (drive arm opposite the driving knee).
    "moveDriveDeg": 110,     // drive arm forward-up at full run
    "moveBackDeg": 45,       // other arm back
    "moveMin": 0.35,         // share of that at walking pace
    "elbowMoveDeg": 80
  }
}
