// Human locomotion: the decider's balance step (the limb test only; walking,
// running and the jump removed, the user's call 2026-11-16). Metres, seconds;
// angles in degrees. Sources in docs/BIOMECHANICS.md section 4.
{
  // A balance step (motion::StepSettings): one foot at a time; the body
  // follows by the decider's shares.
  "step": {
    // Its timing is the decider's per step: the weight shift by the capture
    // point (centre of pressure within the feet), the swing by Fitts' law for
    // the foot's way (human_joints.json "muscles" fitts*).
    "stepHeight": 0.1,       // m ankle apex: the knee bends, the heel rises (was 0.2, the user: the foot lifts too high)
    "toeClearance": 0.012,   // m, a lifted foot's lowest point above the ground at least (minimum toe clearance 1.1-1.3 cm, Winter; BIOMECHANICS 4.5)
    "swingPeakAt": 0.35,     // apex early in the swing (heel up first, toes low at landing)
    "toeOffPitchDeg": 18,    // plantarflexion at toe-off (15-20 deg): the foot rolls over its ball before it lifts
    // A step's passive shares (0..1): none (2026-11-15): the decider's own
    // mechanics move the parts without a goal (human_joints.json decider).
    "passive": { "hands": 0.0, "hips": 0.0, "chest": 0.0 }
  }
}
