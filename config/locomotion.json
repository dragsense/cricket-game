// Fielder locomotion. Metres, seconds; angles in degrees. Sources in
// docs/BIOMECHANICS.md section 4 (walking gait).
{
  "walk": {
    "speed": 1.35,          // m/s at full input (comfortable adult walk)
    "backSpeed": 0.9,       // m/s walking backward (S)
    "sideSpeed": 0.8,       // m/s sidestepping (A/D)
    "acceleration": 5.0,    // m/s^2; full speed within the first step (full-size steps at once)
    "deceleration": 5.0,    // m/s^2; stops within about one step
    "turnRateDeg": 180,     // per second
    "stepK": 0.33,          // step length = stepK * height * (v / refSpeed)^0.42 (0.6 m at 1.8 m)
    "refSpeed": 1.35,
    "swingFraction": 0.8,   // swing time / step period; the rest is double support
    "minSwing": 0.3,        // s
    "maxSwing": 0.5,        // s; also used for the settling steps when stopping
    "stepHeight": 0.08,     // swing arc apex
    "settleDistance": 0.12, // m; on stop, a foot closer than this to its stance spot stays put
    "bob": 0.025,           // pelvis bob peak-to-peak at full speed, lowest in double support
    "sway": 0.02,           // pelvis sway toward the stance foot
    "leanPerSpeedDeg": 2.0, // forward lean per m/s
    "leanPerAccelDeg": 3.0, // forward lean per m/s^2 (back when braking)
    "turnLeanDeg": 3.0,     // lean into turns per (rad/s * m/s)
    "maxLeanDeg": 10,
    "leanRate": 6.0,        // 1/s, lean smoothing
    // Arms swing opposite the same-side leg; full at walking speed forward,
    // fading out for sidesteps and backing up.
    "armSwingDeg": 35,      // shoulder swing, total range
    "armBackBiasDeg": 5,    // swing centre behind vertical (more extension than flexion)
    "elbowBiasDeg": 25,     // mean elbow bend
    "elbowSwingDeg": 20,    // extra bend at the forward end of the swing
    "armRate": 8.0,         // 1/s, arm smoothing
    // Head stays upright and leads turns (W toward a new heading).
    "headStabilise": 0.8,   // 0..1, share of body lean and sway the head cancels
    "headLeadDeg": 30,      // max head turn ahead of the body
    "headRate": 6.0,        // 1/s, head turn smoothing
    // Foot roll: heel strike (toes up), flat, heel rise over the ball, toe-off.
    "landPitchDeg": -10,    // toes up at heel strike
    "heelRise": 0.4,        // stance heel rises over the last 40 % of the other foot's swing
    "toeOffPitchDeg": 18    // plantarflexion at toe-off (15-20 deg)
  },
  // Pace presets (Ctrl: jog, Shift: run). The gait shape blends
  // walk -> jog -> run by the actual speed. docs/BIOMECHANICS.md section 5.
  // Keys left out use the previous preset ("jog" from "walk", "run" from "jog").
  "jog": {
    "speed": 3.0,            // m/s
    "backSpeed": 1.8,        // m/s backpedal
    "sideSpeed": 1.8,        // m/s side shuffle
    "acceleration": 3.5,
    "deceleration": 5.0,
    "turnRateDeg": 220,
    "stepK": 0.6,            // 1.08 m step at 3 m/s (H = 1.8): ~167 steps/min
    "refSpeed": 3.0,
    "swingFraction": 1.0,    // no double support
    "flightFraction": 0.2,   // stance ~40 % of the stride
    "flightLift": 0.08,      // back foot rises after toe-off (heel recovery starts)
    "flightCarry": 0.8,      // and moves forward at this share of body speed
    "heelRise": 0.5,
    "toeOffPitchDeg": 25,
    "landPitchDeg": -8,      // rearfoot/midfoot strike
    "swingPeakAt": 0.42,     // early apex: heel recovery
    "minSwing": 0.2,
    "maxSwing": 0.5,
    "stepHeight": 0.22,      // heel recovery height
    "widthScale": 0.85,      // feet land a little nearer the midline than standing
    "sideFollow": 0.4,       // pelvis shifts only partly over the stance foot
    "bob": 0.07,             // lowest mid-stance (flipped from walking)
    "sway": 0.012,
    "pelvisTwistDeg": 5,
    "chestCounter": 1.4,
    "pelvisDrop": 0.02,      // stance knee ~35 deg mid-stance
    "leanPerSpeedDeg": 1.7,  // ~5 deg at 3 m/s
    "leanPerAccelDeg": 4.0,
    "maxLeanDeg": 20,
    "armSwingDeg": 55,
    "armBackBiasDeg": 0,
    "elbowBiasDeg": 80,      // elbows near 90 deg
    "elbowSwingDeg": 12,
    "armRate": 10.0
  },
  "run": {
    "speed": 5.0,            // m/s (sprint to ~9 m/s comes later)
    // No backSpeed / sideSpeed: backing up and sidesteps stay at jog pace and shape.
    "acceleration": 4.0,
    "turnRateDeg": 240,
    "stepK": 0.92,           // 1.66 m step at 5 m/s: ~181 steps/min
    "refSpeed": 5.0,
    "flightFraction": 0.4,   // stance ~30 % of the stride
    "flightLift": 0.15,
    "flightCarry": 1.0,
    "toeOffPitchDeg": 35,
    "landPitchDeg": -3,      // midfoot
    "swingPeakAt": 0.38,
    "stepHeight": 0.36,      // heel higher toward the buttock
    "widthScale": 0.8,       // feet near, not on, the midline; each keeps its own lane
    "sideFollow": 0.25,      // ~1-2 cm sideways pelvis shift
    "bob": 0.06,             // less oscillation as speed rises
    "sway": 0.008,
    "pelvisTwistDeg": 6,
    "chestCounter": 1.6,
    "pelvisDrop": 0.035,     // stance knee ~40-45 deg mid-stance
    "leanPerSpeedDeg": 1.4,  // ~7 deg at 5 m/s
    "armSwingDeg": 80,       // hands from about chin height to behind the hip
    "armBackBiasDeg": -5,
    "elbowBiasDeg": 88,
    "elbowSwingDeg": 10,
    "armRate": 12.0
  }
}
