// The throw's poses (motion::ThrowPlanner; BIOMECHANICS 10.5). Degrees, metres.
{
  "circles": {
    // Round the chest (hand height) and round the standing throwing shoulder
    // (the release), x the arm's length.
    "slotRadius": 1.0,
    "swingRadius": 1.0,
    // The hand goes to these slots (underarm .. overarm: the arm ~45 deg above
    // level; throws raise it 92-103 deg off the trunk, BIOMECHANICS 10.5); the
    // release points on the throw circle (0: the slot's way, + ahead) [E].
    "slotMinDeg": -60,
    "slotMaxDeg": 35,
    "releaseMinDeg": -30,
    "releaseMaxDeg": 100,
    // The wheel leans the throw circle about the line from the shoulder to the
    // hand drawn back (its pivot), per notch, at most maxTilt either way.
    "tiltStepDeg": 5,
    "maxTiltDeg": 30
  },
  // The force: the mouse draws the hand back from the slot point (m per pixel):
  // straight back to pullReach x the arm's length from the shoulder, then round
  // it, at most pullMax (m), no faster than pullSpeed (m/s) [E].
  "force": { "pullMax": 0.9, "pullReach": 0.95, "pullPerPixel": 0.002, "pullSpeed": 2.0 },
  // Click 3: the hips turn forward, then the chest (by these shares of the time
  // to the release, s: no force .. pullMax; peaks about halfway: hips 25-42 %,
  // upper trunk 50-60 %, BIOMECHANICS 10.5), the chest chestPast beyond square
  // with all the force (22-28 at release). The hand rides the chest, the arm
  // bent, for `ride` of the time, then comes out onto the throw circle (the elbow
  // opens late: ~91 %; not quite straight at the release, ~24 deg: elbowBy) and
  // goes on past the release, slowing down. Rates: the decider's bounds meanwhile
  // (rad/s; a trunk joint's: the upper trunk turns ~19 over its joints). [E]
  "swing": {
    "timeNone": 0.5,
    "timeFull": 0.36,
    "ride": 0.7,
    "hipsBy": 0.66,
    "chestBy": 0.9,
    "elbowBy": 1.2,
    "chestPastDeg": 20,
    "followDeg": 60,
    "followMaxDeg": 140,
    "limbRate": 40,
    "trunkRate": 10,
    "hipsRate": 10
  }
}
