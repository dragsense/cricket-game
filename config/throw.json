// Fielder throw (M4). Values: docs/BIOMECHANICS.md section 10.
{
  "arc": {
    // Both arcs are half circles around the throwing shoulder, radius =
    // factor x arm length (shoulder to wrist); 0.95 keeps the elbow just
    // short of locking.
    "radiusFactor": 0.95
  },
  "aim": {
    // Mouse wheel turns the swing arc about the slot point, per notch.
    "tiltStepDeg": 5
  },
  "swing": {
    // Second click: the hand eases to the swing arc's start (behind), swings
    // forward, fastest at the release point, and follows through to the
    // arc's end. Times are estimates (10.2).
    "windupTime": 0.3,
    "swingTime": 0.12,
    // At the start the elbow is bent (cocking, ~90 deg): the hand is this
    // share of the radius from the shoulder, and the arm extends to full by
    // the release point (the whip).
    "cockReach": 0.6
  },
  "release": {
    // Ball speed along the arc's tangent at release (m/s): ~80 % of an elite
    // fielder's ~31 m/s maximum, where accuracy is best (10.4).
    "speed": 25
  }
}
