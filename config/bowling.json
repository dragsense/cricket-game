// Standing bowler (M5). Values: docs/BIOMECHANICS.md section 11.
{
  "bowler": {
    // Standing at the bowling end behind the popping crease (8.84 m from the
    // pitch centre), facing the batter (+Z). Restart to reset; WASD moves the bowler.
    "position": [0.4, 0.0, -9.4],
    "yawDeg": 0
  },
  "arm": {
    // Elbow bend held through the whole circle: near-straight arm (Law 21:
    // elbow extension at most 15 deg; 11.1). Sets the circle's radius.
    "elbowBendDeg": 10
  },
  "circle": {
    // Second click bowls: the hand eases to startDeg (0 top, 90 in front,
    // 180 below), goes down and back to the horizontal behind, over the top
    // to the release point speeding up, then slows to a stop across the
    // body. Times are estimates for a standing bowler (11.2).
    "startDeg": 135,
    "setupTime": 0.3,
    "downBackTime": 0.5,
    "overTime": 0.18,
    "followTime": 0.4,
    // Share of the way across the body (to the other side) by the end.
    "followAcross": 0.6
  },
  "release": {
    // Ball speed along the circle's tangent at release (m/s). Standing
    // delivery, no run-up: estimate ~20-25 (11.4); spin ~20, pace 35+ needs
    // a run-up.
    "speed": 22,
    // Seconds after the release before the ball is back in the bowler's hand
    // (unless the fielder has picked it).
    "returnDelay": 3
  },
  "aim": {
    // B switches control to the bowler. The mouse picks the release point;
    // after a click the wheel leans the circle from vertical (0 = straight
    // over the top, + = toward the bowling-arm side, round-arm at large
    // values), per notch; a second click bowls.
    "tiltStepDeg": 5,
    "minTiltDeg": -15,
    "maxTiltDeg": 90,
    // Default release: ahead of the vertical over the shoulder (11.3).
    "releaseDeg": 15
  },
  "coil": {
    // B, then the wheel leans the arm circle (yellow) and a click on it sets
    // the action point (white): the hand goes there and the upper body
    // counter-rotates, baseDeg with the point in front of the shoulder up to
    // maxDeg with it behind (more coil, more pace; BIOMECHANICS 11.2). The
    // pelvis takes pelvisShare (hips nearly square: hip-shoulder separation).
    // R cancels.
    "baseDeg": 60,
    "maxDeg": 110,
    "pelvisShare": 0.15,
    "time": 0.35,
    // The upper body leans toward the action point, up to leanDeg with the
    // hand an arm length above the chest (none at chest height or below).
    "leanDeg": 25,
    // Front arm: swings up round its shoulder toward the batter to
    // frontArmRaiseDeg above level at the action point, then back down the
    // same way to frontArmEndDeg (-90 straight down, past it behind) by the
    // release; the wrist frontReach x arm length out (elbow a little bent).
    "frontArmRaiseDeg": 45,
    "frontArmEndDeg": -110,
    "frontReach": 0.85,
    // Back foot steps by this at full coil (m; side toward the bowling arm,
    // forward + toward the batter).
    "backFootSide": 0.1,
    "backFootForward": -0.2
  },
  "swing": {
    // Release click (red point on the circle): the front foot strides
    // strideLength (m) and lands, then action point -> release in time (s),
    // speeding up; the hips finish unwinding by hipLead of it, the shoulders
    // at the release. The elbow takes armIk of the bend the arm IK would
    // make (straight arm; the body makes up the rest: reverse IK).
    "strideLength": 0.7,
    "time": 0.3,
    "hipLead": 0.4,
    "armIk": 0.2,
    // Ball speed at release (m/s), from baseDeg coil to maxDeg.
    "minSpeed": 15,
    "maxSpeed": 26
  },
  "follow": {
    // After the release the arm carries on angleDeg round the circle over
    // time (s), slowing; the shoulders turn turnDeg past square and the hand
    // is carried reach (m) forward, so the body folds after it.
    "angleDeg": 150,
    "time": 0.45,
    "turnDeg": 40,
    "reach": 0.35
  },
  "debug": {
    // The bowling action (action point, swing, follow-through) runs at this
    // share of real speed, to study the motion; 1 = real speed.
    "slowMotion": 0.2
  }
}
