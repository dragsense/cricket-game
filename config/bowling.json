// Standing bowler (M5). Values: docs/BIOMECHANICS.md section 11.
{
  "bowler": {
    // Standing at the bowling end behind the popping crease (8.84 m from the
    // pitch centre), facing the batter (+Z). Restart to reset; WASD moves the bowler.
    "position": [0.4, 0.0, -9.4],
    "yawDeg": 0
  },
  "arm": {
    // Elbow bend held through the whole circle: near-straight arm (Law 21:
    // elbow extension at most 15 deg; 11.1). Sets the circle's radius.
    "elbowBendDeg": 10
  },
  "circle": {
    // Second click bowls: the hand eases to startDeg (0 top, 90 in front,
    // 180 below), goes down and back to the horizontal behind, over the top
    // to the release point speeding up, then slows to a stop across the
    // body. Times are estimates for a standing bowler (11.2).
    "startDeg": 135,
    "setupTime": 0.3,
    "downBackTime": 0.5,
    "overTime": 0.18,
    "followTime": 0.4,
    // Share of the way across the body (to the other side) by the end.
    "followAcross": 0.6
  },
  "release": {
    // Ball speed along the circle's tangent at release (m/s). Standing
    // delivery, no run-up: estimate ~20-25 (11.4); spin ~20, pace 35+ needs
    // a run-up.
    "speed": 22,
    // Seconds after the release before the ball is back in the bowler's hand
    // (unless the fielder has picked it).
    "returnDelay": 3
  },
  "aim": {
    // B switches control to the bowler. After the action click the release
    // circle (red, round the bowling shoulder, arm length) shows and the
    // wheel leans it out to the bowling-arm side only (0 = upright,
    // round-arm at large values), tiltStepDeg per notch, up to maxTiltDeg; the mouse picks
    // the release point and a click bowls. tiltStepDeg also steps the action
    // circle's turn.
    "tiltStepDeg": 5,
    "maxTiltDeg": 90,
    // Default release: ahead of the vertical over the shoulder (11.3).
    "releaseDeg": 15
  },
  "action": {
    // B, then a click on the action circle (yellow) sets the action point
    // (white): only the bowling hand goes there, in time (s); the body
    // follows it (reverse IK). The farther behind the shoulder, the more
    // pace. R cancels.
    "time": 0.35,
    // Action circle (full) round the bowling shoulder, seen from the side
    // (0 straight down, 90 straight ahead). The wheel turns it about the
    // vertical, up to 180 deg either way; Ctrl + wheel sizes it, as a share
    // of the arm length (starts at 1 = arm length, the most): sizeStep per
    // notch, down to minSize.
    // The hand goes round the shoulder from rest past the point by gap (m;
    // the start value: Shift + wheel changes it by gapStep, 0..maxGap), then
    // is pulled back onto it in pullTime (s): the wrist loads.
    "sizeStep": 0.05,
    "minSize": 0.3,
    "gap": 0.1,
    "gapStep": 0.02,
    "maxGap": 0.3,
    "pullTime": 0.08,
    // The front hand's way (blue): from rest round its own shoulder (via the
    // front), all the way, to the end of the bowling hand's way kept apart by
    // frontGap: that share of the front shoulder -> end offset taken off on
    // each axis [x, y, z]. The hand starts frontDelay (s) after the bowling
    // hand, then holds; it goes back down the same way.
    "frontDelay": 0.1,
    "frontGap": [0.4, 0.4, 0.4],
    // Yellow circle turned inward (toward the chest): both elbows swivel
    // outward-up, fully at elbowUpTurnDeg, part way below. Outward: no change.
    "elbowUpTurnDeg": 45
  },
  "coil": {
    // At the action point the chest turns side-on (away from the batter):
    // chest bone first, spine_02 and spine_01 taking what its limit leaves;
    // the hips and the body stay. chestDeg always, growing once the point is
    // less than aheadStart (m) in front of the shoulder, maxDeg an arm length
    // behind. Held to the bottom point, unwound by the release. Values:
    // shoulder counter-rotation ~10-40 deg, hip-shoulder separation ~10-30
    // (BIOMECHANICS 11.5).
    "aheadStart": 0.2,
    "chestDeg": 20,
    "maxDeg": 35
  },
  "back": {
    // The second click sends the hand round the shoulder from the action
    // point down to the bottom point (straight below the shoulder by the
    // arm; cyan) in time (s), speeding up; it holds there for the release.
    "time": 0.3
  },
  "frontArm": {
    "clear": 0.25   // m, the front hand stays at least this far out from the chest's centre line (never inside the body)
  },
  "swing": {
    "lean": 0.4,   // m the red release circle moves toward the batter as the arm comes over (the body leans after the hand)
    // Release click (magenta point on the red release circle): after the
    // way down to the bottom point the hand goes on round the bowling way
    // (back, over) to the release in time (s), speeding up, from the bottom
    // point onto the red circle by a quarter turn. The whole player turns
    // side-on with the hand (the feet step round until the stride): bodyDeg
    // always, plus the angle at the shoulder between the bottom point and the
    // red circle's point furthest across the body (0 when the circle is
    // upright; leanSign -1 turns that part the other way); full at the bottom
    // point, back to straight by the release (side-on around back-foot
    // contact, BIOMECHANICS 11.5). The front foot steps strideLength (m) straight ahead once
    // the hand is strideAt of the way from the action point down to the
    // bottom point (0.5 = halfway).
    "time": 0.3,
    "bodyDeg": 60,
    "leanSign": 1,
    "strideLength": 0.6,
    "strideAt": 0.9,
    // The red circle shows once the body has turned to within this (deg).
    "turnDoneDeg": 3,
    // Ball speed at release (m/s), action point in front .. behind.
    "minSpeed": 15,
    "maxSpeed": 26
  },
  "follow": {
    // After the release the arm carries on angleDeg round the circle over
    // time (s), slowing, and the hand is carried reach (m) forward, so the
    // body folds after it.
    "angleDeg": 150,
    "time": 0.45,
    "reach": 0.35
  },
  "slowMotion": {
    // I toggles slow motion: the whole game runs at this share of real speed.
    "factor": 0.2
  },
  "random": {
    // U: a random action within these ranges (degrees unless noted):
    // action circle turn, action point angle (0 down, 90 ahead, 180 up),
    // circle size (x arm length), gap (m), release circle lean, release point
    // (0 top, + in front; at the top the ball leaves straight ahead at the
    // batter's stumps, whatever the lean). The release follows once the
    // hand holds.
    "turnDeg": { "min": -20, "max": 40 },
    "actionDeg": { "min": 90, "max": 180 },
    "size": { "min": 0.8, "max": 1.0 },
    "gap": { "min": 0.0, "max": 0.2 },
    "tiltDeg": { "min": 0, "max": 20 },
    "releaseDeg": { "min": -3, "max": 3 }
  }
}
