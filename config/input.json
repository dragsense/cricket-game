// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Fielder steps (hold to keep stepping, alternating feet).
    "StepForward": ["W"],
    "StepBack": ["S"],
    "StepLeft": ["A"],
    "StepRight": ["D"]
  }
}
