// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Fielder: W forward (turns to the camera heading), S back, A/D sidestep.
    "StepForward": ["W"],
    "StepBack": ["S"],
    "StepLeft": ["A"],
    "StepRight": ["D"],
    // Pace: walk by default; hold Shift to run, Ctrl to jog.
    "Run": ["LeftShift", "RightShift"],
    "Jog": ["LeftCtrl", "RightCtrl"],
    // Camera: right-drag rotates (default). Tab toggles mouse-look, where the
    // mouse turns the camera with the cursor hidden.
    "ToggleMouseLook": ["Tab"],
    // Reaching: left-click the ground to place the ball there (the hand
    // target); R clears it.
    "ClearReach": ["R"]
  }
}
