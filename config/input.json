// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Human: always faces the camera's heading; W forward, S back, A/D sidestep.
    "StepForward": ["W"],
    "StepBack": ["S"],
    "StepLeft": ["A"],
    "StepRight": ["D"],
    // Held modifier: Shift (limb test: arrows go up/down).
    "ModShift": ["LeftShift", "RightShift"],
    // Camera: right-drag rotates (default). Tab toggles mouse-look, where the
    // mouse turns the camera with the cursor hidden.
    "ToggleMouseLook": ["Tab"],
    // V: free view; the camera can be moved to any angle while the player keeps
    // their heading. V again: the player turns with the camera again.
    "FreeView": ["V"],
    // E / Q: walk faster / slower (locomotion.json "step.speedStep"; from the next step).
    "WalkFaster": ["E"],
    "WalkSlower": ["Q"],
    // Space: held, the player crouches (arms back); let go, he jumps straight
    // up (locomotion.json "jump": the hips target down, then pushed up).
    "Jump": ["Space"],
    // I: slow motion for the whole game (engine.json debug.slowMotionFactor).
    "SlowMotion": ["I"],
    // Limb test (engine.json debug.limbTest): F chooses the limb (right foot,
    // left foot, right hand, left hand); each arrow press jumps its target one
    // step (engine.json debug.limbTestStep) relative to the camera (Up away,
    // Down near, Left/Right sideways; with Shift, Up/Down raise/lower it); it
    // stays where it is left. R resets the pose.
    "ResetPose": ["R"],
    "PoseLimb": ["F"],
    "PoseAway": ["Up"],
    "PoseNear": ["Down"],
    "PoseLeft": ["Left"],
    "PoseRight": ["Right"]
  }
}
