// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Held: the hips are pushed forward (locomotion.json "move"); the body's
    // decider steps after them. Let go: the hips stop, the last step lands.
    "StepForward": ["W"],
    // Held modifier: Shift (limb test: arrows go up/down).
    "ModShift": ["LeftShift", "RightShift"],
    // Camera: right-drag rotates (default). Tab toggles mouse-look, where the
    // mouse turns the camera with the cursor hidden.
    "ToggleMouseLook": ["Tab"],
    // I: slow motion for the whole game (engine.json debug.slowMotionFactor).
    "SlowMotion": ["I"],
    // Limb test (engine.json debug.limbTest): F chooses the target (right
    // foot, left foot, right hand, left hand, hips, chest, head); each arrow
    // press jumps it one step (engine.json debug.limbTestStep) relative to the
    // camera (Up away, Down near, Left/Right sideways; with Shift, Up/Down
    // raise/lower it). With Ctrl held the arrows turn it instead (debug.
    // limbTestTurnDeg per press): Left/Right about up, Up/Down tipping it
    // away/near; Ctrl+Shift Left/Right roll it about the camera's view. The
    // head only turns (its arrows turn it without Ctrl); the chest moves by
    // the trunk bending, within its joints' ranges. It
    // stays where it is left. R resets the pose.
    "ResetPose": ["R"],
    "PoseLimb": ["F"],
    "PoseAway": ["Up"],
    "PoseNear": ["Down"],
    "PoseLeft": ["Left"],
    "PoseRight": ["Right"],
    "PoseTurn": ["LeftCtrl", "RightCtrl"]
  }
}
