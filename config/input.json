// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Fielder: always faces the camera's heading; W forward, S back, A/D sidestep.
    "StepForward": ["W"],
    "StepBack": ["S"],
    "StepLeft": ["A"],
    "StepRight": ["D"],
    // Pace: walk by default; hold Shift to run, Ctrl to jog.
    "Run": ["LeftShift", "RightShift"],
    "Jog": ["LeftCtrl", "RightCtrl"],
    // Camera: right-drag rotates (default). Tab toggles mouse-look, where the
    // mouse turns the camera with the cursor hidden.
    "ToggleMouseLook": ["Tab"],
    // V: free view; the camera can be moved to any angle while the player keeps
    // their heading. V again: the player turns with the camera again.
    "FreeView": ["V"],
    // Space: the fielder reaches for the ball at once (grip, carry back) with
    // the hand on the ball's side; Alt+Space steps toward it first. R abandons
    // the pick.
    "ClearReach": ["R"],
    "Pick": ["Space"],
    "PickStep": ["LeftAlt", "RightAlt"],
    // T: releases the ball from the batting position toward the fielder
    // (config/ball_launch.json "toFielder"); walk to it and press Space.
    "ThrowBall": ["T"],
    // C: the ball goes straight into the fielder's hand, ready to throw.
    "GiveBall": ["C"],
    // B: control the bowler instead of the fielder (WASD moves, the camera
    // follows, the mouse picks the release point; after a click the wheel leans the
    // circle); B again goes back.
    "BowlAim": ["B"],
    // Limb test (engine.json debug.limbTest): F chooses the limb (right foot,
    // left foot, right hand, left hand); the arrows move its target relative
    // to the camera (Up away, Down near, Left/Right sideways; with Shift,
    // Up/Down raise/lower it); it stays where it is left. R resets the pose.
    "PoseLimb": ["F"],
    "PoseAway": ["Up"],
    "PoseNear": ["Down"],
    "PoseLeft": ["Left"],
    "PoseRight": ["Right"],
    // 1-5: launch the ball with a physics preset (config/ball_launch.json).
    "LaunchBall1": ["1"],
    "LaunchBall2": ["2"],
    "LaunchBall3": ["3"],
    "LaunchBall4": ["4"],
    "LaunchBall5": ["5"]
  }
}
