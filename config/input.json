// Action -> up to two keys. Key names: A-Z, 0-9, Space, Escape, Tab, Enter,
// LeftShift, RightShift, LeftCtrl, LeftAlt, Up/Down/Left/Right, F1-F12.
{
  "bindings": {
    "ToggleOverlay": ["F1"],
    "ToggleDebugDraw": ["F2"],
    "ReloadConfig": ["F5"],
    "Quit": ["Escape"],
    // Fielder: W forward (turns to the camera heading), S back, A/D sidestep.
    "StepForward": ["W"],
    "StepBack": ["S"],
    "StepLeft": ["A"],
    "StepRight": ["D"],
    // Pace: walk by default; hold Shift to run, Ctrl to jog.
    "Run": ["LeftShift", "RightShift"],
    "Jog": ["LeftCtrl", "RightCtrl"],
    // Camera: right-drag rotates (default). Tab toggles mouse-look, where the
    // mouse turns the camera with the cursor hidden.
    "ToggleMouseLook": ["Tab"],
    // Ball: hold the left button to drag it on a level plane at its height;
    // E raises it, Q lowers it. Space: the fielder picks it (reach, grip,
    // carry back); R abandons the pick; H cycles the hand: auto, left, right, both.
    "ClearReach": ["R"],
    "BallUp": ["E"],
    "BallDown": ["Q"],
    "Pick": ["Space"],
    "CycleHand": ["H"],
    // Picking hand directly: 1 left, 2 right, 3 both (H also cycles auto).
    "HandLeft": ["1"],
    "HandRight": ["2"],
    "HandBoth": ["3"],
    // T: the feeder throws the ball at the fielder (config/engine.json "feeder");
    // press Space in time to pick it, else it passes. Clicking stops a throw.
    "ThrowBall": ["T"]
  },
  "ballLiftSpeed": 1.0  // m/s while E/Q is held
}
