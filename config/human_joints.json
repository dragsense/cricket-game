// Human joint limits and IK settings. Degrees. Ranges from docs/BIOMECHANICS.md
// section 2 (clinical ROM; spine and neck ranges split across their bones).
//
// Limits are rotations relative to the rest (standing) pose, in the joint's local
// frame, which in rest is aligned with the character: +X = left, +Y = up,
// +Z = forward. Values are for the LEFT side; "_r" bones are mirrored
// automatically (rotations about Y and Z flip sign). Bones not listed are free.
//
// "hinge":       rotation only about "axis", clamped to [min, max].
// "swingTwist":  twist about "twistAxis" clamped to "twist" [min, max]; the swing
//                (rotation about the two other axes, in x,y,z order) is clamped to
//                an elliptical cone with per-direction limits "swing1"/"swing2".
//
// Sign guide (left side):
//   about +X: positive tips +Y toward +Z (spine flexion, knee flexion, plantarflexion);
//             a hanging limb (-Y) moves BACK for positive, FORWARD for negative.
//   about +Z: a hanging limb (-Y) moves outward (+X) for positive.
//   about +Y: forward (+Z) turns toward +X (outward, left side) for positive.
{
  "joints": {
    "spine_01":  { "type": "swingTwist", "twistAxis": "y", "twist": [-5, 5],   "swing1": [-15, 30], "swing2": [-15, 15] },
    "spine_02":  { "type": "swingTwist", "twistAxis": "y", "twist": [-15, 15], "swing1": [-10, 20], "swing2": [-10, 10] },
    "chest":     { "type": "swingTwist", "twistAxis": "y", "twist": [-15, 15], "swing1": [-10, 20], "swing2": [-8, 8] },
    "neck":      { "type": "swingTwist", "twistAxis": "y", "twist": [-35, 35], "swing1": [-30, 28], "swing2": [-20, 20] },
    "head":      { "type": "swingTwist", "twistAxis": "y", "twist": [-35, 35], "swing1": [-30, 28], "swing2": [-20, 20] },

    // Clavicle runs along +X: elevation about Z, protraction (forward) about -Y.
    "clavicle":  { "type": "swingTwist", "twistAxis": "x", "twist": [-10, 10], "swing1": [-15, 25], "swing2": [-5, 40] },
    // Shoulder: X = flexion(-)/extension(+), Z = adduction(-)/abduction(+), twist = internal(-)/external(+).
    "upper_arm": { "type": "swingTwist", "twistAxis": "y", "twist": [-70, 90], "swing1": [-180, 60], "swing2": [-40, 180] },
    // Elbow flexion brings the forearm forward (negative X); pronation/supination is forearm twist.
    "forearm":   { "type": "swingTwist", "twistAxis": "y", "twist": [-80, 80], "swing1": [-145, 3], "swing2": [0, 0] },
    // Wrist: palm faces the body (-X). Z = flexion(-)/extension(+), X = radial(-)/ulnar(+) deviation.
    "hand":      { "type": "swingTwist", "twistAxis": "y", "twist": [0, 0], "swing1": [-20, 30], "swing2": [-80, 70] },

    // Hip: X = flexion(-)/extension(+), Z = adduction(-)/abduction(+), twist = internal(-)/external(+).
    "thigh":     { "type": "swingTwist", "twistAxis": "y", "twist": [-40, 50], "swing1": [-120, 30], "swing2": [-30, 45] },
    // Knee flexion moves the shin back (positive X). Small hyperextension allowance.
    "shin":      { "type": "hinge", "axis": "x", "min": -3, "max": 140 },
    // Ankle: foot runs along +Z. X = dorsiflexion(-)/plantarflexion(+), Y = toe in/out,
    // twist about Z = inversion(-)/eversion(+).
    // Dorsiflexion under the body's weight is set by the knee (the
    // gastrocnemius spans both): 25 +- 6 deg with the knee straight, 39 +- 7
    // from 20 deg of knee bend on, no more beyond (Baumbach et al. 2014, BMC
    // Musculoskelet Disord 15:246, weight-bearing; non-weight-bearing 4 / 20).
    // Between 0 and 20 deg of knee bend: linear between the two measured points.
    "foot":      { "type": "swingTwist", "twistAxis": "z", "twist": [-30, 15], "swing1": [-25, 50], "swing2": [-15, 15],
                   "coupledTo": { "bone": "shin", "bound": "swing1Min", "angleDeg": [0, 20], "valueDeg": [-25, -39] } },
    // Toe extension (toes up) is negative X.
    "toe":       { "type": "hinge", "axis": "x", "min": -70, "max": 40 },

    // Fingers curl toward the palm (-X on the left hand): negative Z.
    "index_01":  { "type": "swingTwist", "twistAxis": "y", "twist": [0, 0], "swing1": [-15, 15], "swing2": [-90, 20] },
    "middle_01": { "type": "swingTwist", "twistAxis": "y", "twist": [0, 0], "swing1": [-10, 10], "swing2": [-90, 20] },
    "ring_01":   { "type": "swingTwist", "twistAxis": "y", "twist": [0, 0], "swing1": [-10, 10], "swing2": [-90, 20] },
    "pinky_01":  { "type": "swingTwist", "twistAxis": "y", "twist": [0, 0], "swing1": [-15, 15], "swing2": [-90, 20] },
    "index_02":  { "type": "hinge", "axis": "z", "min": -100, "max": 0 },
    "middle_02": { "type": "hinge", "axis": "z", "min": -100, "max": 0 },
    "ring_02":   { "type": "hinge", "axis": "z", "min": -100, "max": 0 },
    "pinky_02":  { "type": "hinge", "axis": "z", "min": -100, "max": 0 },
    "index_03":  { "type": "hinge", "axis": "z", "min": -80, "max": 0 },
    "middle_03": { "type": "hinge", "axis": "z", "min": -80, "max": 0 },
    "ring_03":   { "type": "hinge", "axis": "z", "min": -80, "max": 0 },
    "pinky_03":  { "type": "hinge", "axis": "z", "min": -80, "max": 0 },
    // Thumb (runs down, forward and toward the palm): kept loose for now.
    // Thumb: it closes across the palm about an axis with a twist part (its
    // bones point down, forward and in), so twist is allowed on every joint.
    "thumb_01":  { "type": "swingTwist", "twistAxis": "y", "twist": [-45, 45], "swing1": [-50, 50], "swing2": [-50, 50] },
    "thumb_02":  { "type": "swingTwist", "twistAxis": "y", "twist": [-45, 45], "swing1": [-60, 60], "swing2": [-60, 60] },
    "thumb_03":  { "type": "swingTwist", "twistAxis": "y", "twist": [-45, 45], "swing1": [-80, 80], "swing2": [-80, 80] }
  },

  "ik": {
    // Pole directions in character space: knees point forward, elbows back and out.
    "kneePole": [0.0, 0.0, 1.0],
    "elbowPole": [0.3, 0.0, -1.0],
    // ozz two-bone "soften" (1 = none). Only the last 0.1 % eases in, so standing legs
    // are straight (BIOMECHANICS 3.1) and the knee still does not snap.
    "soften": 0.999,
    // Aim IK: share of the look rotation taken by the chest before the head.
    "chestAimWeight": 0.3,
    "headAimWeight": 1.0
  },

  // Hand-driven reaching (M2), docs/BIOMECHANICS.md section 9. Stages: spine,
  // pelvis, clavicle, then two-bone arm IK; the leftover error goes to the later stages.
  "reach": {
    "armReach": 0.97,         // share of full arm length; the elbow never locks straight
    "wristOffset": 0.08,      // m; wrist goal back from the ball centre toward the reaching
                              // shoulder, so the palm meets the ball (above it on the ground)
    // Spine stage (BIOMECHANICS 9.3): one swing about the spine base, split into
    // bend and twist; shares for [spine_01, spine_02, chest], normalised to 1.
    // Twist is mostly thoracic (lumbar twist ~7 deg), bend mostly lumbar.
    "spineBend": [0.6, 0.2, 0.2],
    "spineTwist": [0.2, 0.4, 0.4],
    "spineIterations": 2,     // re-solve to absorb clamping and the higher pivots
    // Pelvis stage (BIOMECHANICS 9.3), rotation vector limits in degrees,
    // character space: [forward tilt (hip flexion, + forward), turn, side tilt].
    // Forward tilt 80 = hip flexion with straight knees (hamstrings).
    "pelvisMinDeg": [-10, -30, -20],
    "pelvisMaxDeg": [80, 30, 20],
    // Body stage (repositionBody driven by the hand): the body moves toward
    // the target by the leftover, in any direction; the hips shift against the
    // centre of mass's overhang beyond the base of support (a capsule
    // supportRadius m around the foot centres, BIOMECHANICS 3, 9.5) x
    // balanceGain, at most maxHipShift m; then the reposition leg clamp keeps
    // the planted feet within reach (no squat limit yet).
    "supportRadius": 0.12,
    "balanceGain": 1.5,
    "maxHipShift": 0.3,
    // After the leg IK the actual centre of mass is measured and the pelvis
    // moved to cancel any overhang (a deep squat swings the knees forward,
    // which no estimate sees); this many passes.
    "balancePasses": 2,
    // Elbow pole [out, down, back] for the left arm (mirrored for the right),
    // made perpendicular to the shoulder-to-target line: the elbow bends away
    // from the body for any target (ground, side, air).
    "elbowPole": [0.4, -1.0, -0.6],
    // Picking (Space), BIOMECHANICS 9.6: the reach starts at once; the wrist
    // goal eases from its rest spot to the ball (following it if it moves)
    // and back in Fitts' law time fittsA + fittsB log2(2D / fittsWidth) (s)
    // for the hand's travel D (m); within gripTolerance (m) the ball is
    // gripped and carried back. Alt+Space steps first: the foot nearer the
    // ball lunges to land beside it, lungeShort m short of it (BIOMECHANICS
    // 8), at most maxLunge m (0 = off).
    "fittsA": 0.1,
    "fittsB": 0.1,
    "fittsWidth": 0.1,
    "gripTolerance": 0.02,
    "ballRadius": 0.036,
    "maxLunge": 0.9,
    "lungeShort": 0.25,
    "lungeDuration": 0.4,
    "lungeHeight": 0.06,
    // Grip: fingers and thumb close fully once the hand is on the ball and stay
    // closed while it is held; otherwise relaxedCurl of it (a natural hand).
    // Full curl per joint [_01, _02, _03], degrees.
    "relaxedCurl": 0.25,
    // Palm centre palmCentre m down the hand from the wrist; it faces the side
    // the fingers curl to; a held ball sits ballRadius + palmThickness m out
    // from it. While reaching, the hand turns so the palm faces the ball.
    "palmCentre": 0.05,
    "palmThickness": 0.015,
    "fingerCurlDeg": [35, 55, 40],
    "thumbCurlDeg": [10, 30, 25]
  },

  // Body repositioning (runs every tick after the foot targets are set;
  // BIOMECHANICS 3.1). The deepest crouch comes from the knee's joint limit.
  // Reaches are hip-to-ankle distances as a fraction of leg length (thigh + shin).
  // Body from the feet (motion::BodyReposition): the moving leg reaches with its
  // own joints; past the hip's range the pelvis tilts (reach.pelvis*Deg limits),
  // past the leg's length it moves toward the foot. No weights.
  // The body's decider (motion::BodyDecider, DECISIONS 2026-11-06): the parts a
  // target needs move together from the start, each with a share by its place
  // in the queue (the user's rule): each next part carries queueShare times the
  // share of the part before it (normalised; a blocked part's share goes to the
  // rest). 0.5 is a starting value, not a measured one.
  "decider": {
    "queueShare": 0.5,
    // Through a foot's swing the hips, between the feet, go this far (m)
    // toward the standing foot at mid-swing and back (a sine from toe-off to
    // heel strike; centre of mass side-to-side 3.9-7 cm in all over a stride,
    // Orendurff et al. 2004).
    "hipsSway": 0.027,
    // Free arms (no goal) cancel this share of the rest of the body's turning
    // about the vertical: arm swing cuts the vertical ground reaction moment
    // by ~63 % in walking (Collins, Adamczyk & Kuo 2009).
    "armCancel": 0.63,
    // Every one of the seven targets is always there (standing, moving with
    // the root); one with a goal pulls fully, the others by their share here,
    // the body's own motion (arm swing, level head, hips between the feet)
    // the rest (the user's design 2026-11-09/10). Head: held firmly (the head
    // is stabilised in space in walking, pitch only ~2-5 deg, Pozzo et al.
    // 1990); hands: looser (the arms swing freely, ~15-30 deg at the
    // shoulder, Collins et al. 2009). Feet on the ground stay put (100 %).
    "passiveInfluence": { "head": 0.9, "hands": 0.5, "hips": 0.3, "chest": 0.5 },
    // Where research measured the split, it replaces the place share: in a
    // forward bend the lumbar spine (spine_01) and the hips (pelvis tilt) move
    // together, lumbar : hip ratio per band of trunk flexion (upper bound,
    // deg): 1.9 up to 30, 0.9 to 60, 0.4 to 90 (Esola et al. 1996,
    // BIOMECHANICS 9.1). Their combined place share is split by it.
    "lumbarHipBandsDeg": [30, 60, 90],
    "lumbarHipRatio": [1.9, 0.9, 0.4],
    // A limb reaches at most this share of its length: the knee and elbow
    // keep a bend, so no straight-limb singularity and no knee snap (quiet
    // standing knee 0-5 deg flexion, BIOMECHANICS 2; 0.96 is ~16 deg).
    "reachClamp": 0.96,
    // s: a target's mode or weight change blends over this (no switch);
    // a foot's support weight over supportBlendTime (the weight shift of a
    // step: double support is 10-12 % of a 1.0-1.2 s stride, BIOMECHANICS 4).
    "blendTime": 0.1,
    "supportBlendTime": 0.12,
    // Bounds on the plan's motion (commanded motion is bounded by muscle
    // activation; the muscles cannot follow a jump anyway): the hips' speed
    // (m/s; fast walking 1.4-2.0) and acceleration (m/s^2; the pelvis in
    // walking peaks 2-4, a push-off ~8), their turn rate, the trunk joints'
    // and head's rates (rad/s; trunk flexion in reaching 1-3, the head's
    // fast turns ~5-6), and a limb joint's (shoulder/hip ~8-12 in fast reaches).
    "hipsMaxSpeed": 2.0,
    "hipsMaxAccel": 8.0,
    "hipsMaxTurnRate": 4.0,
    "trunkMaxRate": 4.0,
    "headMaxRate": 6.0,
    "limbMaxRate": 12.0,
    // m: the plan's pelvis stays within this of the root, level (the capsule
    // leads; the pelvis moves around it: half a step plus the stance).
    "hipsOffsetMax": 0.35
  },

  // Muscles (BIOMECHANICS 14): each joint's motor drives it toward the planned
  // pose, no harder than the joint really is, as fast as muscles switch on.
  "muscles": {
    "activationTime": 0.03,  // s, excitation to force (measured 10-50 ms): motor f = 1 / (2 pi t)
    "damping": 1.0,          // ratio: reaches the pose without overshoot
    // Strongest torque per joint, N m (adult men; one value per joint for both
    // directions: the mean where flexion and extension differ). Not listed:
    // no muscle.
    "maxTorque": {
      "spine_01": 270, "spine_02": 270, "chest": 270,  // trunk extension 268-283
      "head": 35,         // neck 28-41 (the head joint carries the neck)
      "upper_arm": 120,   // shoulder flexion 77, extension 164
      "forearm": 55,      // elbow flexion 51-56
      "hand": 18,         // wrist flexion 21-25, extension 11-13
      "thigh": 197,       // hip extension 197
      "shin": 160,        // knee extension ~205, flexion ~117 (2.3-3.4 / 1.3-1.9 N m/kg x 73 kg)
      "foot": 125,        // ankle plantarflexion, holding (isometric): men 20-39 y 117-131 (Moraux et al. 2013,
                          // BMC Musculoskelet Disord 14:104, knee 90 deg; more with the knee straight, up to ~220);
                          // 70-86 is the isokinetic (moving) value
      "toe": 8            // toe flexors: 1st 1.54, lesser 0.95 N/kg (young men) = ~180 N at the toe pads,
                          // ~4.5 cm from the joint on our skeleton [force measured, lever ours]
    },
    // A limb following its IK target pose (DECISIONS 2026-11-07): each joint's
    // muscle is a spring toward the target angle (Jolt's position motor,
    // stiffness mode; torque capped at maxTorque; gravity held separately).
    // Measured (BIOMECHANICS 14.2): a joint's stiffness rises linearly with
    // the torque it holds, K = stiffness + stiffnessPerTorque |torque|
    // (torque: its gravity hold, plus the balancer's on the stance legs).
    //  - shoulder 10.80 + 3.18 |t|, elbow 8.67 + 6.18 |t| (Gomi & Osu 1998,
    //    J Neurosci 18, Table 2 means, no co-contraction) [P];
    //  - hip 169.4 N m/rad relaxed + 5.15 N m/rad per N at the ankle over a
    //    0.87 m mean leg = 5.95 per N m (Huang et al. 2020, IEEE TNSRE,
    //    Table III; straight leg) [P];
    //  - knee 75 relaxed (cited in Huang 2020) + 6.6 per N m of extension
    //    moment (Granata, Wilson & Padua 2002; 3.3 in flexion, not used: the
    //    knee mostly holds extension) [P];
    //  - trunk: effective 590 N m/rad about L4-L5 upright (Cholewicki et al.
    //    2010: +160 N m/rad = 27%); 785 +- 580 unloaded up to 2200 under
    //    loads (Cholewicki 2000). Our three spine joints in series: 3 x 590
    //    each. No per-torque slope found yet (0) [P, split ours].
    "stiffness": { "upper_arm": 10.8, "forearm": 8.67, "thigh": 169.4, "shin": 75,
                   "spine_01": 1770, "spine_02": 1770, "chest": 1770 },
    "stiffnessPerTorque": { "upper_arm": 3.18, "forearm": 6.18, "thigh": 5.95, "shin": 6.6 },
    // Damping (viscosity), N m s/rad, measured: shoulder 0.63, elbow 0.76
    // (Gomi & Osu 1998, Table 3 intercepts); knee ~2 relaxed (cited in Huang
    // 2020); hip 2-21 relaxed (Huang 2020) and 0.5-10 (Koopman et al. 2016),
    // no mean published: 10, inside both; trunk 33.4 in extension (Cholewicki
    // 2010), 3 x 33.4 per joint in series.
    "jointDamping": { "upper_arm": 0.63, "forearm": 0.76, "thigh": 10, "shin": 2,
                      "spine_01": 100, "spine_02": 100, "chest": 100 }
  },

  // Balance by visible assists (the user's call, DECISIONS 2026-11-08 "Balance
  // by visible assists"): outside forces that stand the physics body, scaled
  // by one balance strength (0..1). Feel tunables, not body values. Springs as
  // frequency (Hz) and damping ratio; forces scale with the whole body's mass,
  // the upright torque with its tilt inertia, so they hold any body size.
  "balance": {
    "hoverShare": 0.7,        // of the weight the hover carries while standing (the feet press the rest: friction)
    "hoverMaxShare": 0.95,    // the hover's most, of the weight (the feet always keep some load)
    "hoverFrequency": 2.0,    // Hz, the hips' height spring toward the stand height
    "hoverDamping": 1.0,
    "uprightFrequency": 2.0,  // Hz, the pelvis's tilt back to upright (its turn about up stays free)
    "uprightDamping": 1.0,
    "uprightMaxTorque": 600,  // N m
    "pullFrequency": 1.0,     // Hz, the centre of mass pulled over the support (a force on the hips, across only)
    "pullDamping": 1.0,
    "pullMaxForce": 250,      // N
    "footFriction": 1.0,      // the feet's and toes' Jolt friction
    "footRestitution": 0.0,   // no bounce (Jolt takes the larger of the two bodies')
    "lockMinStrength": 0.5,   // a planted foot is locked to the ground while the strength is at least this
    "shiftTime": 0.6,         // s: a foot meant to lift waits at most this for the weight to go over the other
    "stepMargin": 0.05,       // m: a step lands this far past the capture point (Hof 2008's offset)
    "stepMaxLength": 0.6,     // m from the stance foot
    "stepMinWidth": 0.12,     // m: the stepping foot stays at least this far to its own side of the stance foot
    "stepClearance": 0.08,    // m: the foot's lift while it travels
    "recoverRate": 1.0        // 1/s: the strength climbs back to 1 after a knock
  },

  "reposition": {
    "standReach": 0.998,      // standing: legs nearly straight (knee about 7 deg; real quiet standing 0-5 deg)
    "maxReach": 1.0,          // a fully straight leg
    "softBand": 0.0015,       // max reach eases in over the last 0.15 % (maxReach - softBand must stay above standReach)
    "followRate": 10.0,       // 1/s, spring frequency: how fast the body settles over the feet
    "damping": 1.0,           // spring damping ratio (1: settles without overshoot, < 1: sways past)
    "stanceDropDeg": 4.0,     // unloaded side's hip drop, all weight on one leg (BIOMECHANICS 4.3)
    "stanceBlendHeight": 0.1  // m; a foot this much higher than the other carries no weight
  }
}
