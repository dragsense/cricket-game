// Shared physics world: Jolt (rigid bodies) and, from Step 3.2, the ball solver.
// Units: metres, seconds, kg. Values: docs/BALL_PHYSICS.md.
{
  "world": {
    "gravity": [0.0, -9.81, 0.0],   // m/s^2 (BALL_PHYSICS 1)
    "airDensity": 1.225,            // kg/m^3, 15 °C at sea level (BALL_PHYSICS 1)
    "wind": [0.0, 0.0, 0.0],        // m/s (BALL_PHYSICS 1)
    "groundHeight": 0.0             // m, top of the ground: the one ground every object stays above
  },
  "jolt": {
    "maxBodies": 256,
    "maxBodyPairs": 1024,
    "maxContactConstraints": 1024,
    "maxSprings": 32,               // Jolt distance-constraint springs (load time)
    "maxJoints": 256,               // Jolt hinge and swing-twist joints (load time)
    "maxCharacters": 32,            // player capsules (Jolt CharacterVirtual, load time)
    // Solver iterations for joints (Jolt override; 0: Jolt's 10). 20/5: a muscle-less crash overshoots 12 deg (was 17).
    // 40: the stance ankle's spring passes its torque through the light foot to the ground (measured one foot,
    // roll axis: 20 steps 80 % of the asked torque, 40 ~93 %, 60 96 %, 200 99.5 %; cost per human per tick
    // 0.22 / 0.30 / 0.37 ms release).
    "jointVelocitySteps": 40,
    "jointPositionSteps": 5,        // > 0: (0: Jolt's 2)
    "tempAllocatorKb": 2048,        // preallocated; no heap use while stepping
    "threads": 0,                   // 0: single-threaded (tiny scene, mobile-friendly)
    "collisionSteps": 1,            // per 120 Hz tick
    "penetrationSlop": 0.001,       // m
    "speculativeContactDistance": 0.005,
    "linearDamping": 0.0,           // air drag on rigid bodies is negligible
    "angularDamping": 0.05
  },
  // Jolt's static ground, top at world.groundHeight.
  "ground": { "friction": 0.6, "restitution": 0.2 },
  // A player's capsule (Jolt CharacterVirtual): it carries the player over the
  // ground, upright always; the procedural body is posed on it. Its height is
  // the player's own (the skeleton's); these are the rest.
  "character": {
    "radius": 0.25,       // m, about half the shoulder width (de Leva: biacromial ~0.4 m)
    "maxSlopeDeg": 45,    // steepest ground it walks on
    "stepUp": 0.3,        // m, highest step it walks up (a stair is ~0.18)
    "stickDown": 0.3,     // m, follows the ground down this far
    "mass": 73,           // kg, as the body (human_joints.json bodyMass)
    "maxStrength": 500,   // N, its push on what it touches
    "padding": 0.02,      // m, gap kept to what it touches
    // The capsule holds the full-physics body up: a spring from the capsule to
    // the pelvis on all six axes (Jolt SixDOF motors). Feel values, not body
    // values: stronger = steadier, weaker = more sway.
    "support": {
      "frequency": 4.0,   // Hz
      "damping": 1.0,     // ratio (1: no overshoot)
      // N: 0, the support no longer carries or pushes the body (the stance
      // legs do: DECISIONS 2026-11-16, the muscle plan P6); it keeps only the
      // body's tilt and turn (maxTorque). Was 2000.
      "maxForce": 0,
      "maxTorque": 600,   // N m
      // m: the hips sink this far below the pose's pelvis with no hold (their
      // weight goes down the thighs onto the knees); below it the spring catches.
      "freeDown": 0       // was 0.03; 0: no up/down band (the legs hold the height)
    },
    // The capsule follows the real hips (DECISIONS 2026-11-11); the hold's
    // anchor rides the plan's pelvis.
    // The real pelvis off the hold's target, level (m): under small nothing;
    // past medium for sustained s a recovery step is reported to the
    // planner; past large the hold lets go (the strength goes) when the
    // release is on.
    "pelvisError": { "small": 0.03, "medium": 0.08, "large": 0.2, "sustained": 0.3 },
    // The hold lets go when the hips (pelvis) lean past these, seen from the
    // centre of both feet (limits of stability, NeuroCom / Nashner:
    // forward 8.5, back 4.5, sideways ~8 deg); blended between them. Then the
    // body falls; at rest (slower than restSpeed m/s for recoverWait s) the
    // capsule goes under the pelvis and the hold eases back in over recoverTime s.
    "release": {
      "on": false,        // off for now: the hold never lets go (the user's call, 2026-11-09)
      "forwardDeg": 8.5,
      "backDeg": 4.5,
      "leftDeg": 8.0,
      "rightDeg": 8.0,
      "restSpeed": 0.2,
      "recoverWait": 1.0,
      "recoverTime": 1.0
    }
  }
}
